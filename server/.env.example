PORT=4000
# User accounts (phone sign-in, profile) are stored in the `users` collection when this is set.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
# Optional: Google Places Autocomplete + Details (venue search on create / lock-in). Same key often works for both.
# GOOGLE_MAPS_API_KEY=
# Optional: Google Cloud Storage for admin-uploaded event-card images. When GCS_BUCKET
# is set, file uploads are stored in the bucket and the card library keeps the public URL.
# Without it, uploads fall back to inline data URLs. Credentials come from Application
# Default Credentials (GOOGLE_APPLICATION_CREDENTIALS / Workload Identity) unless GCS_KEY_FILE is set.
# GCS_BUCKET=your-bucket-name
# GCS_PROJECT_ID=
# GCS_KEY_FILE=/path/to/service-account.json
# GCS_PUBLIC_BASE_URL=   # optional CDN/custom domain; defaults to https://storage.googleapis.com/<bucket>

MAGIC_LINK_SECRET=replace-me
SESSION_SECRET=replace-me
# Seed demo +155555501xx users/plans: disabled in production unless SEED_DEMO_ACCOUNTS=1 (real accounts come only from Twilio Verify sign-in).
# SEED_DEMO_ACCOUNTS=0
# Twilio — phone sign-in uses Verify (create a Service at https://console.twilio.com/us1/develop/verify/services)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: SMS invites still use Programmable Messaging (needs a From number)
# TWILIO_FROM_NUMBER=+15551234567
# Optional SMTP config:
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=commons@example.com
